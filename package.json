{
  "name": "be-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write src test scripts docs *.json *.ts *.mjs *.md .github/workflows/*.yml docker-compose*.yml docker/telemetry/*.yaml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:build:up": "docker compose up --build",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:stop": "docker compose stop",
    "template:init": "node scripts/init-template.mjs",
    "test:tooling": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "format:check": "prettier --check src test scripts docs *.json *.ts *.mjs *.md .github/workflows/*.yml docker-compose*.yml docker/telemetry/*.yaml",
    "docker:monitoring:up": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up --build -d",
    "docker:monitoring:down": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml down",
    "api:generate": "pnpm build && node dist/openapi/export.js",
    "api:check": "pnpm build && node dist/openapi/export.js --check"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "cockatiel": "^4.0.0",
    "helmet": "^8.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "neverthrow": "^8.2.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  }
}
