# Copy to .env. template:init does not touch existing local environment files.
NODE_ENV=development
PORT=3000
APP_NAME=nestjs-app
APP_DESCRIPTION=Application API
APP_VERSION=0.0.1
# APP_REPOSITORY_URL=https://github.com/your-org/your-repo
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Credentials require explicit origins, e.g. http://localhost:3001.
CORS_ORIGINS=*
CORS_CREDENTIALS=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
SHUTDOWN_TIMEOUT=10000
# Opt in for load-balancer readiness propagation; must be below SHUTDOWN_TIMEOUT.
SHUTDOWN_DRAIN_DELAY_MS=0
HEALTH_MEMORY_HEAP_MB=150
HEALTH_RSS_MEMORY_MB=150
HEALTH_DISK_THRESHOLD_PERCENT=0.95

FEATURE_MONITORING=false
FEATURE_RESILIENCE=false
# Additional retries; 3 allows up to 4 executions. Retry only idempotent operations.
RESILIENCE_RETRY_MAX_ATTEMPTS=3
RESILIENCE_RETRY_INITIAL_DELAY_MS=128
RESILIENCE_RETRY_MAX_DELAY_MS=30000
RESILIENCE_TIMEOUT_MS=5000
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=10000
RESILIENCE_BULKHEAD_MAX_CONCURRENT=10
RESILIENCE_BULKHEAD_MAX_QUEUE=0

# Compose-only: set a password before starting docker:monitoring:up.
GRAFANA_ADMIN_PASSWORD=
