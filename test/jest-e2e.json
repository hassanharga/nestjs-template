{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.js$": "@swc/jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(.pnpm/.*cockatiel|cockatiel))"
  ]
}
